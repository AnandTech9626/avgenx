# AVGENX Academy server configuration. Copy to .env (never commit .env) or set these in your
# host's environment. Everything here is read only by the server; nothing reaches the browser.

# development | production. Production refuses to start with development test accounts,
# without a super administrator, or with insecure cookies.
NODE_ENV=development
PORT=8080
# 127.0.0.1 in development, 0.0.0.0 in production by default.
HOST=
# SQLite file holding accounts, roles, sessions and the sign-in audit. Put it on a persistent,
# backed-up volume. It contains password hashes: restrict file permissions.
DB_PATH=data/avgenx.db
# Session cookies get the Secure flag and the __Host- prefix. Defaults to true in production;
# only set false for local HTTP development.
COOKIE_SECURE=
# Set true only behind a reverse proxy you control that sets X-Forwarded-For / X-Forwarded-Proto.
TRUST_PROXY=false

# Optional: AI copilot through the server (key stays on the server).
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_MAX_TOKENS=1200

# Tests only: a specific Chromium binary for Playwright.
CHROMIUM_PATH=
