# Copy to /etc/avgenx.env (readable by root and the avgenx user only: chmod 640).
NODE_ENV=production
HOST=127.0.0.1
PORT=8080
# Caddy (or another reverse proxy on this machine) terminates HTTPS and forwards to the app.
TRUST_PROXY=true
DB_PATH=/opt/avgenx-academy/data/avgenx.db
ACCOUNTS_XLSX=/opt/avgenx-academy/accounts.xlsx
# Sign everyone out when the service restarts (default). Set true to keep sessions.
KEEP_SESSIONS=false
# Shorter idle sign-out for shared lab computers, in minutes (default 480 = 8 hours).
SESSION_IDLE_MINUTES=120
# Optional AI copilot
# ANTHROPIC_API_KEY=
